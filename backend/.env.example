# ============================================================
# ShilpSetu Backend Environment Configuration
# Copy this file to .env and replace with your credentials
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase (PostgreSQL Database & Auth & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OAuth Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=15

# Upload Constraints
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=5

# AI Image Processing
AI_IMAGE_MAX_SIZE_MB=10
IMAGE_BG_REMOVAL_PROVIDER=none
REMOVEBG_API_KEY=

# AI Voice & Speech-to-Text
VOICE_PROVIDER=none
GOOGLE_SPEECH_API_KEY=
GOOGLE_SPEECH_LANGUAGE_CODES=hi-IN,gu-IN,en-IN
AI_AUDIO_MAX_SIZE_MB=25
AI_AUDIO_MAX_DURATION_SEC=300

# AI Catalog Generation (Google Gemini)
CATALOG_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Market Price Intelligence
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=

# Storage Provider ('supabase' | 'local')
STORAGE_PROVIDER=supabase
STORAGE_LOCAL_DIR=./uploads

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=
